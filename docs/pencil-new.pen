                      ],
                      "children": [
                        {
                          "type": "text",
                          "id": "SaZ61",
                          "name": "Code 1",
                          "fill": "#9CDCFE",
                          "content": "import time",
                          "fontFamily": "Inter",
                          "fontSize": 12,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "tlZcp",
                          "name": "Code 2",
                          "fill": "#9CDCFE",
                          "fontFamily": "Inter",
                          "fontSize": 12,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "cXfcn",
                          "name": "Code 3",
                          "fill": "#DCDCAA",
                          "content": "def timer(func):",
                          "fontFamily": "Inter",
                          "fontSize": 12,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "GfhoV",
                          "name": "Code 4",
                          "fill": "#DCDCAA",
                          "content": "  def wrapper(*args):",
                          "fontFamily": "Inter",
                          "fontSize": 12,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "v3uws",
                          "name": "Code 5",
                          "fill": "#C586C0",
                          "content": "    start = time.time()",
                          "fontFamily": "Inter",
                          "fontSize": 12,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "hnLRj",
                          "name": "Code 6",
                          "fill": "#9CDCFE",
                          "content": "    result = func(*args)",
                          "fontFamily": "Inter",
                          "fontSize": 12,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "gbLb0",
                          "name": "Code 7",
                          "fill": "#C586C0",
                          "content": "    return result",
                          "fontFamily": "Inter",
                          "fontSize": 12,
                          "fontWeight": "normal"
                        }
